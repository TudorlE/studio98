# ---------------------------------------------------------------------------
# STUDIO 98 — environment
# Copy to `.env.local` and fill in. The site builds and the marketing page
# renders with NONE of these set; booking + payment activate as you add them.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, OG, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (booking backend) -------------------------------------------
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments --------------------------------------------------------------
# No card processor: clients pay via MIA (static QR, see `booking.mia` in
# lib/site.ts) or at the studio. MIA payments are confirmed by hand in /admin.

# --- Email (transactional confirmations) --------------------------------
# Sent through Resend from the verified domain 98.studio (DNS on Vercel).
# Without RESEND_API_KEY, confirmation emails are only logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Studio 98 <rezervari@98.studio>"
# Studio inbox (Gmail): gets a "Rezervare nouă" alert for every booking,
# and receives the replies clients send to their confirmation email.
BOOKING_NOTIFY_EMAIL=

# --- Admin panel (/admin) -------------------------------------------------
# Password for the booking admin panel at /admin. Pick your own.
ADMIN_PASSWORD=
