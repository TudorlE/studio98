# ---------------------------------------------------------------------------
# STUDIO 98 — environment
# Copy to `.env.local` and fill in. The site builds and the marketing page
# renders with NONE of these set; booking + payment activate as you add them.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, OG, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (booking backend) -------------------------------------------
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ------------------------------------------------------------
# Which provider to use. Currently: "stripe".
# To add a Moldova-friendly processor, implement lib/payments/<name>.ts and
# register it in lib/payments/index.ts, then set this value.
PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (transactional confirmations) --------------------------------
# Optional. Without it, confirmation emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Studio 98 <bookings@studio98.example>"
