# ---------------------------------------------------------------------------
# STUDIO 98 — environment
# Copy to `.env.local` and fill in. The site builds and the marketing page
# renders with NONE of these set; booking + payment activate as you add them.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, OG, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (booking backend) -------------------------------------------
# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments --------------------------------------------------------------
# "La studio" (pay-at-studio + MIA, see `booking.mia` in lib/site.ts) always
# works. "Online, cu cardul" needs Stripe configured below — without these,
# choosing it returns a clear error instead of silently faking a payment.
PAYMENT_PROVIDER=stripe

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (transactional confirmations) --------------------------------
# Optional. Without it, confirmation emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Studio 98 <bookings@studio98.example>"

# --- Admin panel (/admin) -------------------------------------------------
# Password for the booking admin panel at /admin. Pick your own.
ADMIN_PASSWORD=
